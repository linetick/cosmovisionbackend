# Авторизация
# 1 = включена (по умолчанию), 0 = отключена (анонимный доступ)
AUTH_REQUIRED=1

# LLM backend: local | vllm | yandex
LLM_BACKEND=yandex

# Yandex Cloud
YANDEX_API_KEY=
YANDEX_PROJECT_ID=
YANDEX_PROMPT_ID=
YANDEX_ROUTER_PROMPT_ID=

# Compact-ответы для AR (короче и быстрее)
AR_COMPACT_RESPONSES=1
