@startuml
title Диаграмма последовательности: отправка текстового запроса на сервер

actor "Пользователь" as User
participant "Клиентское\nприложение" as Client
participant "API сервер" as API
participant "Модуль\nаутентификации\n(JWT)" as Auth
database "База данных" as DB
participant "Классификатор\nинтентов" as Router
participant "Семантический\nпоиск" as Search
database "База \nзнаний" as KB
participant "Генератор \nответов" as LLM

User -> Client : Вводит текстовый запрос

Client -> API : POST /query\n(text, JWT-токен)

API -> Auth : Проверка JWT-токена
Auth -> DB : Поиск пользователя по токену
DB --> Auth : Данные пользователя

alt Токен недействителен или пользователь не найден
    Auth --> API : Ошибка авторизации
    API --> Client : 401 Unauthorized
else Токен действителен
    Auth --> API : Пользователь авторизован

    API -> DB : Проверка подписки пользователя
    DB --> API : Статус подписки

    alt Подписка активна
        API -> DB : Загрузка истории чата\n(последние сообщения сессии)
        DB --> API : История сообщений
    end

    API -> Router : Классификация интента\n(нормализованный запрос)
    Router --> API : Тип интента

    alt Интент: action (команда управления)
        API --> Client : Команда управления\n(rotate, scale, reset и др.)
    else Интент: off_topic / unknown_command
        API --> Client : Сообщение об ограничениях тематики
    else Интент: info / hybrid
        API -> Search : Семантический поиск\n(запрос + контекст сцены)
        Search -> KB : Извлечение релевантных фрагментов
        KB --> Search : Релевантные фрагменты
        Search --> API : Контекст из базы знаний

        alt Релевантный контекст найден
            API -> LLM : Запрос + контекст +\nистория чата (если есть)
            LLM --> API : Сгенерированный ответ
        else Контекст не найден
            API -> LLM : Запрос без контекста +\nистория чата (если есть)
            LLM --> API : Сгенерированный ответ
        end

        alt Подписка активна
            API -> DB : Сохранение сообщения\nи ответа в историю сессии
        end

        API --> Client : Текстовый ответ
    end
end

Client --> User : Отображение результата

@enduml
